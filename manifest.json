{
  "manifest_version": 3,
  "name": "Kinship – works with Firefox Sync",
  "short_name": "Kinship",
  "version": "1.0.0",
  "description": "Unofficial Firefox Sync client for Chrome & Edge: your Firefox bookmarks, synced tabs, history and Send Tab, end-to-end encrypted.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "unlimitedStorage", "alarms", "contextMenus", "notifications", "activeTab"],
  "optional_permissions": ["bookmarks", "tabs", "history"],
  "host_permissions": [
    "https://accounts.firefox.com/*",
    "https://*.accounts.firefox.com/*",
    "https://*.services.mozilla.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Kinship: send this tab to a Firefox Sync device",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  }
}
